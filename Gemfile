source "https://rubygems.org"

# Gemme officielle utilisée par GitHub Pages : garantit que ce que tu vois
# en local (jekyll serve) correspond à ce que GitHub va générer en ligne.
# Facultatif : uniquement utile si tu veux prévisualiser le site sur ton
# ordinateur avant de le mettre en ligne. GitHub Pages n'en a pas besoin
# pour construire le site depuis le dépôt.
gem "github-pages", group: :jekyll_plugins
